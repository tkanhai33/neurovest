# NeuroVest local environment example
APP_ENV=local
APP_NAME=NeuroVest

# Backend
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# Database
DATABASE_URL=postgresql+psycopg://neurovest:neurovest_dev_password@localhost:5432/neurovest

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_DEFAULT_CHAT_MODEL=qwen3:8b
OLLAMA_CODER_MODEL=qwen2.5-coder:14b
OLLAMA_HEAVY_CODER_MODEL=qwen3-coder:30b

# Market data
FINNHUB_API_KEY=replace_me_optional_free_tier

# Broker is locked for MVP
BROKER_ENABLED=false
LIVE_TRADING_ENABLED=false
CANARY_TRADING_ENABLED=false
