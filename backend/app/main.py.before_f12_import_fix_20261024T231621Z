    principal: AuthenticatedPrincipal = Depends(
        require_authenticated_principal
    ),
):
    owner_user_id = (
        _training_principal_subject(
            principal
        )
    )

    runs = (
        list_training_sessions_for_user_profile(
            owner_user_id=owner_user_id,
            limit=100,
        )
    )

    completed = [
        run
        for run in runs
        if run.get("status")
        == "completed"
    ]

    latest = (
        completed[0]
        if completed
        else (
            runs[0]
            if runs
            else None
        )
    )

    lifetime_rows = sum(
        int(
            run.get(
                "rows_evaluated",
                0,
            )
            or 0
        )
        for run in completed
    )

    lifetime_decisions: dict[str, int] = {}

    lifetime_reward_total = 0.0

    for run in completed:
        decisions = run.get(
            "decision_counts"
        )

        if isinstance(
            decisions,
            dict,
        ):
            for decision, count in decisions.items():
                try:
                    normalized_count = int(
                        count
                    )
                except (
                    TypeError,
                    ValueError,
                ):
                    continue

                lifetime_decisions[
                    str(decision)
                ] = (
                    lifetime_decisions.get(
                        str(decision),
                        0,
                    )
                    +
                    normalized_count
                )

        contribution = run.get(
            "sanitized_learning_contribution"
        )

        if not isinstance(
            contribution,
            dict,
        ):
            continue

        symbol_confidence = contribution.get(
            "symbol_confidence"
        )

        if not isinstance(
            symbol_confidence,
            list,
        ):
            continue

        for symbol in symbol_confidence:
            if not isinstance(
                symbol,
                dict,
            ):
                continue

            try:
                average_reward = float(
                    symbol.get(
                        "average_reward",
                        0.0,
                    )
                    or 0.0
                )

                observations = int(
                    symbol.get(
                        "observations",
                        0,
                    )
                    or 0
                )

            except (
                TypeError,
                ValueError,
            ):
                continue

            lifetime_reward_total += (
                average_reward
                *
                observations
            )

    current_run = None

    if latest is not None:
        contribution = latest.get(
            "sanitized_learning_contribution"
        )

        if not isinstance(
            contribution,
            dict,
        ):
            contribution = {}

        confidence_rows = contribution.get(
            "symbol_confidence"
        )

        if not isinstance(
            confidence_rows,
            list,
        ):
            confidence_rows = []

        confidence_by_symbol = {}

        for row in confidence_rows:
            if not isinstance(
                row,
                dict,
            ):
                continue

            symbol = row.get(
                "symbol"
            )

            if isinstance(
                symbol,
                str,
            ):
                confidence_by_symbol[
                    symbol
                ] = row

        symbols = []

        per_symbol = latest.get(
            "per_symbol"
        )

        if isinstance(
            per_symbol,
            dict,
        ):
            for symbol, values in per_symbol.items():
                if not isinstance(
                    values,
                    dict,
                ):
                    continue

                confidence = (
                    confidence_by_symbol.get(
                        str(symbol),
                        {}
                    )
                )

                decisions = {}

                for decision in (
                    "BUY_SIGNAL",
                    "HOLD",
                    "SELL_SIGNAL",
                ):
                    value = values.get(
                        decision
                    )

                    if isinstance(
                        value,
                        (int, float),
                    ):
                        decisions[
                            decision
                        ] = int(
                            value
                        )

                symbols.append({
                    "symbol":
                        str(symbol),

                    "decisions":
                        decisions,

                    "cycles":
                        values.get(
                            "cycles"
                        ),

                    "last_close":
                        values.get(
                            "last_close"
                        ),

                    "last_timestamp":
                        values.get(
                            "last_timestamp"
                        ),

                    "observations":
                        confidence.get(
                            "observations"
                        ),

                    "average_reward":
                        confidence.get(
                            "average_reward"
                        ),

                    "average_confidence":
                        confidence.get(
                            "average_confidence"
                        ),
                })

        current_reward_total = 0.0

        for row in confidence_rows:
            if not isinstance(
                row,
                dict,
            ):
                continue

            try:
                current_reward_total += (
                    float(
                        row.get(
                            "average_reward",
                            0.0,
                        )
                        or 0.0
                    )
                    *
                    int(
                        row.get(
                            "observations",
                            0,
                        )
                        or 0
                    )
                )

            except (
                TypeError,
                ValueError,
            ):
                continue

        current_run = {
            "run_id":
                latest.get(
                    "run_id"
                ),

            "status":
                latest.get(
                    "status"
                ),

            "rows":
                int(
                    latest.get(
                        "rows_evaluated",
                        0,
                    )
                    or 0
                ),

            "reward_total":
                round(
                    current_reward_total,
                    8,
                ),

            "average_confidence":
                latest.get(
                    "average_confidence"
                ),

            "decision_counts":
                (
                    latest.get(
                        "decision_counts"
                    )
                    if isinstance(
                        latest.get(
                            "decision_counts"
                        ),
                        dict,
                    )
                    else {}
                ),

            "symbols":
                symbols,
        }

    return {
        "current_run":
            current_run,

        "lifetime": {
            "runs":
                len(
                    completed
                ),

            "rows_processed":
                lifetime_rows,

            "reward_total":
                round(
                    lifetime_reward_total,
                    8,
                ),

            "decision_counts":
                lifetime_decisions,
        },

        "scope":
            "authenticated_user_profile",
    }


