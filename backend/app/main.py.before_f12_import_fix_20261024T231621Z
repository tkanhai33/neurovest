from sqlalchemy import func as _chat_stats_func

from backend.app.stacks.chat_public.persistence.chat_models import (
    ChatMessageRecord as _ChatStatsMessageRecord,
    ChatThreadRecord as _ChatStatsThreadRecord,
    ToolEvidenceRecord as _ChatStatsToolEvidenceRecord,
)


@app.get(
    "/api/v1/developer/chat/statistics",
    tags=[
        "developer",
        "chat",
        "statistics",
    ],
)
async def get_developer_chat_statistics(
    principal: AdministrativePrincipal = Depends(
        require_administrative_principal
    ),
):
    """
    Developer-only server-authoritative Chat statistics.

    Database access is SELECT-only.
    """

    _require_developer_training_role(
        principal
    )

    async with async_session() as session:

        thread_count = int(
            (
                await session.execute(
                    select(
                        _chat_stats_func.count()
                    ).select_from(
                        _ChatStatsThreadRecord
                    )
                )
            ).scalar_one()
            or 0
        )

        message_count = int(
            (
                await session.execute(
                    select(
                        _chat_stats_func.count()
                    ).select_from(
                        _ChatStatsMessageRecord
                    )
                )
            ).scalar_one()
            or 0
        )

        user_message_count = int(
            (
                await session.execute(
                    select(
                        _chat_stats_func.count()
                    )
                    .select_from(
                        _ChatStatsMessageRecord
                    )
                    .where(
                        _ChatStatsMessageRecord.role
                        == "user"
                    )
                )
            ).scalar_one()
            or 0
        )

        assistant_message_count = int(
            (
                await session.execute(
                    select(
                        _chat_stats_func.count()
                    )
                    .select_from(
                        _ChatStatsMessageRecord
                    )
                    .where(
                        _ChatStatsMessageRecord.role
                        == "assistant"
                    )
                )
            ).scalar_one()
            or 0
        )

        tool_evidence_count = int(
            (
                await session.execute(
                    select(
                        _chat_stats_func.count()
                    ).select_from(
                        _ChatStatsToolEvidenceRecord
                    )
                )
            ).scalar_one()
            or 0
        )

        tool_evidence_success_count = int(
            (
                await session.execute(
                    select(
                        _chat_stats_func.count()
                    )
                    .select_from(
                        _ChatStatsToolEvidenceRecord
                    )
                    .where(
                        _ChatStatsToolEvidenceRecord.status
                        == "success"
                    )
                )
            ).scalar_one()
            or 0
        )

        intent_rows = (
            await session.execute(
                select(
                    _ChatStatsMessageRecord.intent,
                    _chat_stats_func.count(),
                )
                .where(
                    _ChatStatsMessageRecord.role
                    == "assistant"
                )
                .group_by(
                    _ChatStatsMessageRecord.intent
                )
                .order_by(
                    _chat_stats_func.count().desc()
                )
            )
        ).all()

        provider_rows = (
            await session.execute(
                select(
                    _ChatStatsMessageRecord.provider,
                    _chat_stats_func.count(),
                )
                .where(
                    _ChatStatsMessageRecord.role
                    == "assistant"
                )
                .group_by(
                    _ChatStatsMessageRecord.provider
                )
                .order_by(
                    _chat_stats_func.count().desc()
                )
            )
        ).all()

        model_rows = (
            await session.execute(
                select(
                    _ChatStatsMessageRecord.model,
                    _chat_stats_func.count(),
                )
                .where(
                    _ChatStatsMessageRecord.role
                    == "assistant"
                )
                .group_by(
                    _ChatStatsMessageRecord.model
                )
                .order_by(
                    _chat_stats_func.count().desc()
                )
            )
        ).all()

        tool_status_rows = (
            await session.execute(
                select(
                    _ChatStatsToolEvidenceRecord.status,
                    _chat_stats_func.count(),
                )
                .group_by(
                    _ChatStatsToolEvidenceRecord.status
                )
                .order_by(
                    _chat_stats_func.count().desc()
                )
            )
        ).all()

        tool_rows = (
            await session.execute(
                select(
                    _ChatStatsToolEvidenceRecord.tool_name,
                    _chat_stats_func.count(),
                )
                .group_by(
                    _ChatStatsToolEvidenceRecord.tool_name
                )
                .order_by(
                    _chat_stats_func.count().desc()
                )
            )
        ).all()

        learned_strategy_rows = (
            await session.execute(
                select(
                    _DeveloperStatsStrategyKnowledge
                )
                .order_by(
                    _DeveloperStatsStrategyKnowledge.updated_at.desc(),
                    _DeveloperStatsStrategyKnowledge.created_at.desc(),
                )
                .limit(
                    25
                )
            )
        ).scalars().all()

    qualified_statistics = {
        "conversation_count":
            thread_count,

        "total_message_count":
            message_count,

        "user_message_count":
            user_message_count,

        "assistant_message_count":
            assistant_message_count,

        "tool_evidence_count":
            tool_evidence_count,

        "tool_evidence_success_count":
            tool_evidence_success_count,

        "intent_distribution": [
            {
                "intent":
                    (
                        str(value)
                        if value
                        else "unclassified"
                    ),
                "count":
                    int(count),
            }
            for value, count
            in intent_rows
        ],

        "provider_distribution_internal": [
            {
                "value":
                    (
                        str(value)
                        if value is not None
                        else "none"
                    ),
                "count":
                    int(count),
            }
            for value, count
            in provider_rows
        ],

        "model_distribution_internal": [
            {
                "value":
                    (
                        str(value)
                        if value is not None
                        else "none"
                    ),
                "count":
                    int(count),
            }
            for value, count
            in model_rows
        ],

        "tool_status_distribution": [
            {
                "status":
                    (
                        str(value)
                        if value is not None
                        else "none"
                    ),
                "count":
                    int(count),
            }
            for value, count
            in tool_status_rows
        ],

        "tool_distribution": [
            {
                "tool":
                    (
                        str(value)
                        if value is not None
                        else "none"
                    ),
                "count":
                    int(count),
            }
            for value, count
            in tool_rows
        ],

        "learned_strategy_knowledge": [
            {
                "id":
                    str(
                        row.id
                    ),

                "strategy_id":
                    row.strategy_id,

                "strategy_version":
                    int(
                        row.strategy_version
                    ),

                "strategy_name":
                    row.strategy_name,

                "name":
                    row.name,

                "strategy_family":
                    row.strategy_family,

                "asset_class":
                    row.asset_class,

                "generation_source":
                    row.generation_source,

                "validation_status":
                    row.validation_status,

                "lifecycle_state":
                    row.lifecycle_state,

                "admission_decision":
                    row.admission_decision,

                "promotion_status":
                    row.promotion_status,

                "history_row_count":
                    row.history_row_count,

                "feature_count":
                    row.feature_count,

                "symbols":
                    list(
                        row.symbols
                        or []
                    ),

                "created_at":
                    (
                        row.created_at.isoformat()
                        if row.created_at
                        is not None
                        else None
                    ),

                "updated_at":
                    (
                        row.updated_at.isoformat()
                        if row.updated_at
                        is not None
                        else None
                    ),
            }
            for row
            in learned_strategy_rows
        ],
    }

    return {
        "status":
            "ok",

        "classification":
            "developer_chat_statistics",

        "source":
            "server-authoritative-postgresql",

        "scope":
            "system",

        "visibility":
            "developer_internal",

        "read_only":
            True,

        "database_mutation":
            False,

        "qualified_statistics":
            qualified_statistics,

        "not_yet_qualified": [
            "systemwide_chat_request_count",
            "systemwide_chat_success_count",
            "systemwide_chat_failure_count",
            "systemwide_chat_average_latency_ms",
            "systemwide_chat_p95_latency_ms",
        ],

        "broker_execution":
            False,

        "live_execution":
            False,
    }


