{
  "version": "ARCH_LOCK_V1",
  "rules": {
    "dependency_direction": "L5 -> L3 -> L4",
    "forbidden": [
      "L4 imports L3",
      "L4 imports L5",
      "L3 imports L5",
      "any circular import"
    ],
    "allowed": {
      "L5": [
        "L3"
      ],
      "L3": [
        "L4"
      ],
      "L4": []
    },
    "enforcement": "pre_pytest_import_scan + runtime_guard"
  }
}