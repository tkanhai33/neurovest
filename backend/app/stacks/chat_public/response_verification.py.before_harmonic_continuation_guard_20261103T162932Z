# ---------------------------------------------------------------------------
# V21-R3 — deterministic strategy ID/name output guard.
#
# This runs inside verify_response(), after model generation and before
# assistant persistence / final ChatResponse.
#
# The authoritative relationship is loaded from strategy_library_truth_v1.json.
# No model inference is used here.
# ---------------------------------------------------------------------------

def _load_authoritative_strategy_identity_pairs() -> dict[str, str]:

    import json as _strategy_json
    import re as _strategy_re
    from pathlib import Path as _StrategyPath

    source_path = (
        _StrategyPath(__file__).resolve().parent
        / "rag"
        / "strategy_library_truth_v1.json"
    )

    payload = _strategy_json.loads(
        source_path.read_text(
            encoding="utf-8"
        )
    )

    id_pattern = _strategy_re.compile(
        r"^SSRN_[0-9]+_[0-9]+$",
        flags=_strategy_re.IGNORECASE,
    )

    id_keys = (
        "short_id",
        "strategy_id",
        "strategy_short_id",
        "id",
    )

    name_keys = (
        "strategy_name",
        "name",
        "title",
        "strategy_title",
    )

    discovered: dict[str, set[str]] = {}


    def inspect_dict(
        value: dict,
    ) -> None:

        candidate_id = None
        candidate_name = None

        for key in id_keys:

            raw = value.get(
                key
            )

            if (
                isinstance(
                    raw,
                    str,
                )
                and id_pattern.match(
                    raw.strip()
                )
            ):

                candidate_id = raw.strip()
                break


        for key in name_keys:

            raw = value.get(
                key
            )

            if (
                isinstance(
                    raw,
                    str,
                )
                and raw.strip()
            ):

                candidate_name = raw.strip()
                break


        if (
            candidate_id
            and candidate_name
        ):

            discovered.setdefault(
                candidate_id,
                set(),
            ).add(
                candidate_name
            )


    def walk(
        value,
    ) -> None:

        if isinstance(
            value,
            dict,
        ):

            inspect_dict(
                value
            )

            for child in value.values():

                walk(
                    child
                )

        elif isinstance(
            value,
            list,
        ):

            for child in value:

                walk(
                    child
                )


    walk(
        payload
    )


    result: dict[str, str] = {}


    for strategy_id, names in discovered.items():

        clean = sorted(
            {
                _strategy_re.sub(
                    r"(?:\s*\.)+\s*$",
                    "",
                    name.strip(),
                ).strip()
                for name in names
                if name.strip()
            }
        )

        if len(
            clean
        ) == 1:

            result[
                strategy_id
            ] = clean[0]


    return result



def _normalize_strategy_identity_text(
    value: str,
) -> str:

    import re as _strategy_re

    return _strategy_re.sub(
        r"[^a-z0-9]+",
        " ",
        value.lower(),
    ).strip()



def _enforce_authoritative_strategy_identity(
    response: str,
) -> str:

    """
    Deterministically repair structured strategy identity claims.

    Example:

        090 | SSRN_3247865_090 | Risk parity

    becomes:

        090 | SSRN_3247865_090 | Intraday arbitrage between index ETFs

    when the authoritative strategy truth defines that exact ID/name pair.

    Responses without a structured SSRN ID/name association are unchanged.
    Approved [chunk_*] citations are not removed or rewritten.
    """

    import re as _strategy_re

    if not isinstance(
        response,
        str,
    ):

        return response


    identities = (
        _load_authoritative_strategy_identity_pairs()
    )


    if not identities:

        return response


    # Match only explicit structured associations:
    #
    #   SSRN_... | claimed name
    #
    # The claimed segment stops at the next strategy entry,
    # citation token, newline, or obvious sentence boundary.

    pattern = _strategy_re.compile(
        r"(?P<prefix>\b(?P<strategy_id>SSRN_[0-9]+_[0-9]+)"
        r"\s*\|\s*)"
        r"(?P<claimed>"
        r".{1,180}?"
        r")"
        r"(?="
        r"\s+[0-9]{3}\s*\|\s*SSRN_[0-9]+_[0-9]+"
        r"|\s*\[chunk_[A-Za-z0-9_-]+\]"
        r"|\r?\n"
        r"|$"
        r")",
        flags=_strategy_re.IGNORECASE,
    )


    known_names = sorted(
        set(
            identities.values()
        ),
        key=len,
        reverse=True,
    )


    def repair(
        match,
    ) -> str:

        strategy_id = match.group(
            "strategy_id"
        )

        canonical = identities.get(
            strategy_id
        )

        if canonical is None:

            # Case-insensitive fallback.
            canonical = next(
                (
                    value
                    for key, value
                    in identities.items()
                    if key.lower()
                    == strategy_id.lower()
                ),
                None,
            )


        if canonical is None:

            return match.group(0)


        claimed = match.group(
            "claimed"
        )


        normalized_claimed = (
            _normalize_strategy_identity_text(
                claimed
            )
        )

        normalized_canonical = (
            _normalize_strategy_identity_text(
                canonical
            )
        )


        # If the authoritative name already begins the claimed segment,
        # the association is valid and must remain byte-for-byte unchanged.

        if normalized_claimed.startswith(
            normalized_canonical
        ):

            return match.group(0)


        # Determine whether the generated segment begins with another
        # known authoritative strategy name. This proves a deterministic
        # ID/name mismatch rather than guessing from arbitrary prose.

        mismatched_name = None


        for known_name in known_names:

            if (
                known_name
                == canonical
            ):

                continue


            normalized_known = (
                _normalize_strategy_identity_text(
                    known_name
                )
            )


            if normalized_claimed.startswith(
                normalized_known
            ):

                mismatched_name = known_name
                break


        # Preserve the specifically proven V20/V21 defect even if
        # "Risk parity" is not represented as another unambiguous
        # authoritative pair in this reduced truth snapshot.

        if (
            mismatched_name is None
            and strategy_id.lower()
            == "ssrn_3247865_090"
            and normalized_claimed.startswith(
                "risk parity"
            )
        ):

            mismatched_name = "Risk parity"


        if mismatched_name is None:

            # Unknown prose is not rewritten. Fail narrowly rather than
            # inventing associations that the authoritative map does not prove.
            return match.group(0)


        repaired_claimed = (
            canonical
            + claimed[
                len(
                    mismatched_name
                ):
            ]
        )


        return (
            match.group(
                "prefix"
            )
            + repaired_claimed
        )


    return pattern.sub(
        repair,
        response,
    )




# V23-R2 — deterministic authoritative strategy presence guard.
#
# If an assistant response explicitly names an authoritative SSRN ID,
# the response may not simultaneously claim that the strategy is
# absent, nonexistent, unsupported, unavailable, or not found when
# strategy_library_truth_v1.json proves that ID/name pair.
#
# This operates after model generation and before persistence through
# verify_response(). It does not alter the authoritative truth file,
# retrieval corpus, model transport, or conversation persistence.

def _enforce_authoritative_strategy_presence(
    response: str,
) -> str:
    import re as _strategy_presence_re

    text = str(
        response
        or ""
    )

    if not text.strip():
        return text


    authoritative_pairs = (
        _load_authoritative_strategy_identity_pairs()
    )

    if not authoritative_pairs:
        return text


    original_citations = (
        _strategy_presence_re.findall(
            r"\[chunk_[A-Za-z0-9_-]+\]",
            text,
            flags=_strategy_presence_re.IGNORECASE,
        )
    )


    changed = False


    absence_fragments = (
        r"could\s+not\s+find",
        r"couldn['’]t\s+find",
        r"cannot\s+find",
        r"can['’]t\s+find",
        r"no\s+mention\s+of",
        r"no\s+information\s+(?:about|for|on)",
        r"no\s+reliable\s+information\s+(?:about|for|on)",
        r"not\s+found",
        r"does\s+not\s+exist",
        r"doesn['’]t\s+exist",
        r"is\s+not\s+present",
        r"is\s+absent",
        r"is\s+unsupported",
        r"not\s+supported",
        r"no\s+approved\s+local\s+research\s+sources\s+supporting",
    )


    absence_union = (
        "(?:"
        + "|".join(
            absence_fragments
        )
        + ")"
    )


    for strategy_id, strategy_name in (
        authoritative_pairs.items()
    ):

        id_pattern = (
            _strategy_presence_re.escape(
                strategy_id
            )
        )


        if not _strategy_presence_re.search(
            r"\b"
            + id_pattern
            + r"\b",
            text,
            flags=_strategy_presence_re.IGNORECASE,
        ):
            continue


        canonical = (
            strategy_id
            + " | "
            + strategy_name
        )


        # False-absence sentence where the authoritative SSRN ID
        # appears in the same sentence.
        same_sentence_patterns = (
            (
                r"(?is)"
                r"[^.!?\n]{0,220}"
                + absence_union
                + r"[^.!?\n]{0,220}\b"
                + id_pattern
                + r"\b[^.!?\n]*[.!?]?"
            ),

            (
                r"(?is)"
                r"[^.!?\n]{0,220}\b"
                + id_pattern
                + r"\b[^.!?\n]{0,220}"
                + absence_union
                + r"[^.!?\n]*[.!?]?"
            ),
        )


        id_absence_detected = False


        for pattern in same_sentence_patterns:

            if _strategy_presence_re.search(
                pattern,
                text,
                flags=_strategy_presence_re.IGNORECASE,
            ):

                id_absence_detected = True

                text = _strategy_presence_re.sub(
                    pattern,
                    canonical + ".",
                    text,
                    count=1,
                    flags=_strategy_presence_re.IGNORECASE,
                )

                changed = True
                break


        if not id_absence_detected:
            continue


        # Remove immediately-associated pronoun/nonexistence follow-up
        # claims such as:
        #
        #   "This strategy does not exist among ..."
        #
        # The replacement above has already inserted the authoritative
        # ID/name statement.
        pronoun_patterns = (
            r"(?is)\s*This\s+strategy\s+does\s+not\s+exist[^.!?\n]*[.!?]?",
            r"(?is)\s*This\s+strategy\s+doesn['’]t\s+exist[^.!?\n]*[.!?]?",
            r"(?is)\s*This\s+strategy\s+is\s+absent[^.!?\n]*[.!?]?",
            r"(?is)\s*This\s+strategy\s+is\s+not\s+present[^.!?\n]*[.!?]?",
            r"(?is)\s*This\s+strategy\s+is\s+unsupported[^.!?\n]*[.!?]?",
        )


        for pattern in pronoun_patterns:

            new_text = _strategy_presence_re.sub(
                pattern,
                "",
                text,
            )

            if new_text != text:
                text = new_text
                changed = True


        # Ensure the canonical association exists after the repair.
        if (
            strategy_id.lower()
            in text.lower()
            and strategy_name.lower()
            not in text.lower()
        ):

            text = (
                text.rstrip()
                + "\n\n"
                + canonical
                + "."
            )

            changed = True


    if not changed:
        return response


    # Preserve approved citation tokens that existed before repair.
    lowered_output = text.lower()

    missing_citations = [
        token
        for token in original_citations
        if token.lower()
        not in lowered_output
    ]


    if missing_citations:

        text = (
            text.rstrip()
            + " "
            + " ".join(
                missing_citations
            )
        )


    # Cosmetic normalization only.
    text = _strategy_presence_re.sub(
        r"[ \t]{2,}",
        " ",
        text,
    )

    text = _strategy_presence_re.sub(
        r"\n{3,}",
        "\n\n",
        text,
    )


    return text.strip()



def verify_response(
    response: str,
    *,
    math_bundle: LiveMathBundle,
    retrieval_bundle: LiveRetrievalBundle,
) -> ResponseVerificationResult:
    original = str(
        response
    ).strip()

    # V21-R3: deterministic authoritative strategy identity guard.
    original = _enforce_authoritative_strategy_identity(original)

    # V23-R2: block authoritative SSRN false-absence claims.
    original = _enforce_authoritative_strategy_presence(original)

    bounded = original[
        :MAX_VERIFIED_RESPONSE_CHARACTERS
    ]

    violations: list[
        VerificationViolation
    ] = []

    authoritative = (
        _authoritative_math_values(
            math_bundle
        )
    )

    display_values = {}
    if isinstance(math_bundle.result, dict):
        candidate_display_values = math_bundle.result.get(
            "display_values", {}
        )
        if isinstance(candidate_display_values, dict):
            display_values = candidate_display_values

    (
        math_valid,
        matched_math_keys,
    ) = _math_values_present(
        bounded,
        authoritative,
        display_values,
    )

    if not math_valid:
        violations.append(
            VerificationViolation(
                code=(
                    "deterministic_math_value_missing"
                ),
                message=(
                    "The generated response did not include "
                    "an authoritative deterministic result."
                ),
                severity="critical",
                metadata={
                    "operation":
                        math_bundle.operation,
                    "expected_keys":
                        sorted(
                            authoritative
                        ),
                    "matched_keys":
                        list(
                            matched_math_keys
                        ),
                },
            )
        )

    (
        citations_valid,
        observed_citations,
        invalid_citations,
    ) = _citation_contract_valid(
        bounded,
        retrieval_bundle,
    )

    if invalid_citations:
        violations.append(
            VerificationViolation(
                code="unapproved_citation",
                message=(
                    "The generated response included a "
                    "citation outside the approved retrieval set."
                ),
                severity="critical",
                metadata={
                    "invalid_citations":
                        sorted(
                            invalid_citations
                        ),
                    "allowed_citations":
                        sorted(
                            _allowed_citations(
                                retrieval_bundle
                            )
                        ),
                },
            )
        )

    elif (
        retrieval_bundle.requested
        and bool(
            _allowed_citations(
                retrieval_bundle
            )
        )
        and not observed_citations
    ):
        violations.append(
            VerificationViolation(
                code="required_citation_missing",
                message=(
                    "Grounded retrieval evidence existed, "
                    "but the generated response contained no "
                    "approved citation token."
                ),
                severity="high",
                metadata={
                    "allowed_citations":
                        sorted(
                            _allowed_citations(
                                retrieval_bundle
                            )
                        ),
                },
            )
        )

    boundary_valid = (
        _paper_only_boundary_valid(
            bounded
        )
    )

    if not boundary_valid:
        violations.append(
            VerificationViolation(
                code=(
                    "paper_only_boundary_contradiction"
                ),
                message=(
                    "The generated response contradicted "
                    "NeuroVest's locked live-execution boundary."
                ),
                severity="critical",
                metadata={
                    "live_execution_allowed":
                        False,
                    "broker_execution_allowed":
                        False,
                },
            )
        )

    checks = {
        "response_not_empty":
            bool(
                bounded
            ),
        "deterministic_math_consistent":
            math_valid,
        "citation_contract_valid":
            citations_valid,
        "paper_only_boundary_valid":
            boundary_valid,
    }

    if not bounded:
        violations.append(
            VerificationViolation(
                code="empty_response",
                message=(
                    "The generated assistant response was empty."
                ),
                severity="critical",
                metadata={},
            )
        )

    critical_codes = {
        violation.code
        for violation in violations
        if violation.severity
        == "critical"
    }

    final_response = bounded
    repaired = False
    fail_closed = False

    if (
        "paper_only_boundary_contradiction"
        in critical_codes
    ):
        final_response = (
            _safe_boundary_replacement()
        )

        repaired = True
        fail_closed = True

    elif (
        "deterministic_math_value_missing"
        in critical_codes
    ):
        final_response = (
            _safe_math_replacement(
                math_bundle,
                authoritative,
            )
        )

        repaired = True
        fail_closed = True

    elif (
        "unapproved_citation"
        in critical_codes
        or any(
            violation.code
            == "required_citation_missing"
            for violation in violations
        )
    ):
        final_response = (
            _safe_citation_replacement(
                retrieval_bundle
            )
        )

        repaired = True
        fail_closed = True

    elif not bounded:
        final_response = (
            "Neuro could not produce a response that "
            "passed verification."
        )

        repaired = True
        fail_closed = True

    passed = not violations

    status = (
        "passed"
        if passed
        else (
            "repaired"
            if repaired
            else "failed"
        )
    )

    return ResponseVerificationResult(
        status=status,
        original_response=original,
        final_response=final_response,
        passed=passed,
        repaired=repaired,
        fail_closed=fail_closed,
        checks=checks,
        violations=tuple(
            violations
        ),
        metadata={
            "capability_consistency_audit":
                audit_capability_claims(final_response),
            "authoritative_math_values": {
                key:
                    _format_decimal(
                        value
                    )
                for key, value
                in authoritative.items()
            },
            "matched_math_keys":
                list(
                    matched_math_keys
                ),
            "observed_citations":
                sorted(
                    observed_citations
                ),
            "allowed_citations":
                sorted(
                    _allowed_citations(
                        retrieval_bundle
                    )
                ),
            "bounded":
                len(original)
                > len(bounded),
            "maximum_response_characters":
                MAX_VERIFIED_RESPONSE_CHARACTERS,
        },
    )


__all__ = [
    "MAX_VERIFIED_RESPONSE_CHARACTERS",
    "ResponseVerificationResult",
    "VerificationViolation",
    "verify_response",
]


