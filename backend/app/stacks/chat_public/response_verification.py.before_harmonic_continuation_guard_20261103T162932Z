NUMBER_PATTERN = re.compile(
    r"""
    (?<![\w.])
    [-+]?
    (?:
        \d{1,3}(?:,\d{3})+
        |
        \d+
    )
    (?:\.\d+)?
    %?
    (?!\w)
    """,
    re.VERBOSE,
)

CITATION_PATTERN = re.compile(
    r"\[chunk_[A-Za-z0-9_-]+\]"
)

MAX_VERIFIED_RESPONSE_CHARACTERS = 20_000

