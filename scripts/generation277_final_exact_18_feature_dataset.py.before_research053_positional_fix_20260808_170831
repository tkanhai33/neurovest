    "return_1d",
    "return_5d",
    "return_10d",
    "return_20d",
    "volatility_5d",
    "volatility_20d",
    "range_fraction",
    "close_to_sma_5",
    "close_to_sma_20",
    "close_to_sma_50",
    "volume_change_1d",
    "volume_ratio_20d",
)

RESEARCH_FEATURES = (
    "research_053_cumulative_momentum_12m_skip_1m",
    "research_053_cumulative_rank",
    "research_053_mean_momentum_12m_skip_1m",
    "research_053_risk_adjusted_momentum_12m_skip_1m",
    "research_053_risk_adjusted_rank",
    "research_053_volatility_12m_skip_1m",
)

FEATURES = (
    *BASE_FEATURES,
    *RESEARCH_FEATURES,
)

TARGET = "target_next_up"

FUTURE_RETURN = "future_return_1d"

RAW_COLUMNS = (
    "timestamp",
    "provider_symbol",
    "open",
    "high",
    "low",
    "close",
    "volume",
)


def sha256_file(
    path: Path,
) -> str:
    digest = hashlib.sha256()

    with path.open("rb") as handle:
        for block in iter(
            lambda: handle.read(
                1024 * 1024
            ),
            b"",
        ):
            digest.update(block)

    return digest.hexdigest()


def finite_json(
    value: Any,
) -> Any:
    if isinstance(value, dict):
        return {
            str(key):
                finite_json(child)
            for key, child
            in value.items()
        }

    if isinstance(value, (list, tuple)):
        return [
            finite_json(child)
            for child in value
        ]

    if isinstance(value, np.generic):
        value = value.item()

    if (
        isinstance(value, float)
        and not math.isfinite(value)
    ):
        return None

    return value


def write_json(
    path: Path,
    value: Any,
) -> None:
    path.write_text(
        json.dumps(
            finite_json(value),
            indent=2,
            sort_keys=True,
            default=str,
        )
        + "\n",
        encoding="utf-8",
    )


