def run_git(*args):
    try:
        p = subprocess.run(
            ["git", *args],
            cwd=ROOT,
            capture_output=True,
            text=True,
            timeout=30,
        )
        return p.stdout.strip() if p.returncode == 0 else None
    except Exception:
        return None

def write_json(name, obj):
    path = OUT / name
    path.write_text(
        json.dumps(obj, indent=2, sort_keys=True, default=str) + "\n"
    )
    path.chmod(0o600)

def write_text(name, value):
    path = OUT / name
    path.write_text(value)
    path.chmod(0o600)

def domain_for(path):
    return [
        name
        for name, prefixes in DOMAINS.items()
        if any(path.startswith(prefix) for prefix in prefixes)
    ]

def find_sources():
    found = set()
    skipped = []

    for root_name in SOURCE_ROOTS:
        base = ROOT / root_name

        if base.is_file():
            if base.suffix in SOURCE_SUFFIXES and not base.is_symlink():
                found.add(base.relative_to(ROOT).as_posix())
            continue

        if not base.is_dir() or base.is_symlink():
            continue

        for current, directories, filenames in os.walk(base):
            directories[:] = [
                item for item in directories
                if item not in EXCLUDED_DIRS
                and not item.startswith(".")
                and not (Path(current) / item).is_symlink()
            ]

            for filename in filenames:
                path = Path(current) / filename

                if path.suffix not in SOURCE_SUFFIXES or path.is_symlink():
                    continue

                if any(token in filename.lower() for token in (
                    ".before_", ".backup", ".bak", ".old", ".orig"
                )):
                    continue

                try:
                    if path.stat().st_size > MAX_BYTES_PER_FILE:
                        skipped.append(path.relative_to(ROOT).as_posix())
                        continue
                except OSError:
                    continue

                found.add(path.relative_to(ROOT).as_posix())

                if len(found) > MAX_FILES:
                    raise RuntimeError(
                        f"Source scan exceeds safety limit of {MAX_FILES}"
                    )

    return sorted(found), skipped

def package_module(path):
    value = path.replace("/", ".")
    if value.endswith(".py"):
        value = value[:-3]
    if value.endswith(".__init__"):
        value = value[:-9]
    return value

def resolve_relative(module, level, target, is_package):
    parts = module.split(".")
    package_parts = parts if is_package else parts[:-1]

    if level > len(package_parts) + 1:
        return None

    prefix = package_parts[:len(package_parts) - level + 1]
    if target:
        prefix += target.split(".")

    return ".".join(prefix)

def py_analyze(path, content):
    tree = ast.parse(content, filename=path)

    module = package_module(path)
    is_package = path.endswith("/__init__.py")

    imports = []
    bindings = {}
    definitions = []
    calls = []
    routes = []
    classes = []
    todo = []

    for node in tree.body:
        if isinstance(node, ast.Import):
            for item in node.names:
                alias = item.asname or item.name.split(".")[0]
                imports.append(item.name)
                bindings[alias] = item.name

        elif isinstance(node, ast.ImportFrom):
            target = (
                resolve_relative(
                    module,
                    node.level,
                    node.module,
                    is_package
                )
                if node.level
                else (node.module or "")
            )
            if target:
                imports.append(target)

            for item in node.names:
                if item.name == "*":
                    continue

                alias = item.asname or item.name
                bindings[alias] = (
                    target + "." + item.name if target else item.name
                )

    def expr_name(node):
        if isinstance(node, ast.Name):
            return node.id
        if isinstance(node, ast.Attribute):
            parent = expr_name(node.value)
            return parent + "." + node.attr if parent else node.attr
        return None

    def analyze_function(node, owner=""):
        name = f"{owner}.{node.name}" if owner else node.name
        definitions.append({
            "name": name,
            "line": node.lineno,
            "async": isinstance(node, ast.AsyncFunctionDef),
        })

        local_calls = set()

        class Collector(ast.NodeVisitor):
            def visit_Call(self, call):
                value = expr_name(call.func)
                if value:
                    local_calls.add(value)
                self.generic_visit(call)

            def visit_FunctionDef(self, nested):
                return

            def visit_AsyncFunctionDef(self, nested):
                return

            def visit_Lambda(self, nested):
                return

        visitor = Collector()
        for statement in node.body:
            visitor.visit(statement)

        for callee in sorted(local_calls)[:MAX_EDGES_PER_FILE]:
            calls.append({
                "caller": name,
                "callee": callee,
                "line": node.lineno,
            })

        for deco in node.decorator_list:
            if isinstance(deco, ast.Call):
                decorator = expr_name(deco.func)
                if decorator and decorator.split(".")[-1] in {
                    "get", "post", "put", "delete", "patch", "api_route",
                    "websocket",
                }:
                    url = None
                    if deco.args and isinstance(deco.args[0], ast.Constant):
                        if isinstance(deco.args[0].value, str):
                            url = deco.args[0].value

                    routes.append({
                        "handler": name,
                        "method": decorator.split(".")[-1].upper(),
                        "path_fragment": url,
                        "line": node.lineno,
                        "note": "Prefix/router mounting not resolved",
                    })

    for node in tree.body:
        if isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef)):
            analyze_function(node)

        elif isinstance(node, ast.ClassDef):
            classes.append({"name": node.name, "line": node.lineno})
            for child in node.body:
                if isinstance(child, (ast.FunctionDef, ast.AsyncFunctionDef)):
                    analyze_function(child, node.name)

    for line_number, line in enumerate(content.splitlines(), 1):
        if re.search(r"\b(TODO|FIXME|XXX|HACK)\b", line, re.I):
            todo.append(line_number)
            if len(todo) >= 100:
                break

    return {
        "language": "python",
        "module": module,
        "imports": sorted(set(imports)),
        "bindings": bindings,
        "functions": definitions,
        "classes": classes,
        "calls": calls,
        "routes": routes,
        "todo_lines": todo,
        "syntax": "PASS",
    }

JS_IMPORT_RE = re.compile(
    r"""(?:import\s+(?:[\s\S]*?\s+from\s+)?|"""
    r"""(?:export\s+[\s\S]*?\s+from\s+)|"""
    r"""(?:require\s*\()\s*['"]([^'"]+)['"]""",
    re.M,
)

JS_FUNCTION_RE = re.compile(
    r"""(?:export\s+)?(?:default\s+)?(?:async\s+)?"""
    r"""function\s+([A-Za-z_$][\w$]*)\s*\("""
    r"""|(?:export\s+)?(?:const|let)\s+"""
    r"""([A-Za-z_$][\w$]*)\s*="""
    r"""\s*(?:async\s*)?(?:\([^)]*\)|[A-Za-z_$][\w$]*)\s*=>"""
    r"""|(?:export\s+)?class\s+([A-Za-z_$][\w$]*)""",
    re.M,
)

def js_analyze(path, content):
    imports = sorted(set(JS_IMPORT_RE.findall(content)))
    definitions = []

    for match in JS_FUNCTION_RE.finditer(content):
        name = next(
            (value for value in match.groups() if value),
            "anonymous",
        )
        definitions.append({
            "name": name,
            "line": content.count("\n", 0, match.start()) + 1,
            "async": False,
        })

    return {
        "language": "javascript_typescript",
        "imports": imports,
        "functions": definitions,
        "classes": [],
        "calls": [],
        "routes": [],
        "todo_lines": [
            i for i, line in enumerate(content.splitlines(), 1)
            if re.search(r"\b(TODO|FIXME|XXX|HACK)\b", line, re.I)
        ][:100],
        "syntax": "NOT_COMPILED",
        "note": "JS/TS imports and declarations are lexical; not a full compiler AST",
    }

