# Resolve Python imports to repository source where possible.
module_connections = []
function_connections = []
unresolved_calls = []

for path, info in inventory.items():
    if info["language"] != "python":
        continue

    for imported in info["imports"]:
        target = modules.get(imported)

        if target is None:
            pieces = imported.split(".")
            for n in range(len(pieces) - 1, 0, -1):
                target = modules.get(".".join(pieces[:n]))
                if target:
                    break

        if target and target != path:
            module_connections.append({
                "from": path,
                "to": target,
                "import": imported,
                "type": "static_import",
            })

    own_names = {
        entry["name"]
        for entry in info["functions"]
    }
    top_names = {
        name.split(".")[0]
        for name in own_names
    }

    for call in info["calls"]:
        callee = call["callee"]
        head = callee.split(".")[0]
        target = None
        resolution = "unresolved_or_external"

        if callee in own_names or callee in top_names:
            target = path
            resolution = "same_module"

        elif head in info["bindings"]:
            import_path = info["bindings"][head]
            parts = import_path.split(".")

            for n in range(len(parts), 0, -1):
                candidate = modules.get(".".join(parts[:n]))
                if candidate:
                    target = candidate
                    resolution = "import_binding_candidate"
                    break

        if target:
            function_connections.append({
                "from_file": path,
                "from_function": call["caller"],
                "call": callee,
                "to_file": target,
                "resolution": resolution,
            })
        else:
            unresolved_calls.append({
                "file": path,
                "function": call["caller"],
                "call": callee,
            })

